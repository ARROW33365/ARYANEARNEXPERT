<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CCARYAN</title>

<style>
*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,sans-serif;
}

body{
background:linear-gradient(180deg,#0a2b43,#081c2c);
display:flex;
justify-content:center;
align-items:center;
min-height:100vh;
color:white;
}

.card{
width:95%;
max-width:420px;
text-align:center;
padding:30px 20px;
}

.logo{
width:140px;
height:140px;
border-radius:50%;
background:#000;
display:flex;
align-items:center;
justify-content:center;
margin:auto;
font-size:55px;
}

.logo img{
width:100%;
height:100%;
border-radius:50%;
object-fit:cover;
}

h1{
margin-top:20px;
font-size:34px;
font-weight:bold;
}

p{
margin-top:10px;
color:#ddd;
}

.timer{
display:flex;
justify-content:center;
gap:15px;
margin:30px 0;
}

.box{
background:#FFC107;
color:#000;
width:120px;
padding:18px;
border-radius:10px;
font-size:30px;
font-weight:bold;
}

.box span{
display:block;
font-size:15px;
font-weight:normal;
}

.btn{
display:block;
margin-top:10px;
background:linear-gradient(90deg,#0ba8ff,#005dff);
padding:18px;
border-radius:40px;
text-decoration:none;
color:white;
font-size:22px;
font-weight:bold;
transition:.3s;
}

.btn:hover{
transform:scale(1.03);
}

.rating{
margin-top:30px;
font-size:24px;
color:#FFD700;
}

.small{
margin-top:18px;
font-size:14px;
line-height:24px;
color:#ddd;
}

footer{
margin-top:20px;
font-size:13px;
color:#aaa;
}
</style>
</head>

<body>

<div class="card">

<div class="logo">
✈️
</div>

<h1>CCARYAN</h1>

<p>Community • Updates • Entertainment</p>

<div class="timer">

<div class="box">
00
<span>Min</span>
</div>

<div class="box" id="sec">
45
<span>Sec</span>
</div>

</div>

<a class="btn" href= https://t.me/CCWARYAN
🚀 Join Telegram Channel
</a>

<div class="rating">
⭐⭐⭐⭐⭐ 4.9 Community Rating
</div>

<div class="small">
18+ Only • Entertainment purpose only<br>
Participate responsibly
</div>

<footer>
© 2026 CCARYAN
</footer>

</div>

<script>

let sec=45;

setInterval(()=>{

sec--;

if(sec<0){

sec=59;

}

document.getElementById("sec").innerHTML=
sec.toString().padStart(2,"0")+"<span>Sec</span>";

},1000);

</script>

</body>
</html>
